style "window"
{
  engine "pixmap"
  {
    image
    {
      function				= FLAT_BOX
      recolorable			= TRUE
      state			= NORMAL
      file			= "Images/bg.png"
      border	= { 0, 0, 0, 0 }
      stretch	= FALSE
      overlay_file     		= "Others/bg-p.png"
      overlay_border	= { 0, 0, 0, 0 }
      overlay_stretch	= TRUE
    }
    image
    {
      function				= FLAT_BOX
      recolorable			= FALSE
      state			= INSENSITIVE
      file			= "Images/bg.png"
      border	= { 0, 0, 0, 0 }
      stretch	= TRUE
    }
  }
}
