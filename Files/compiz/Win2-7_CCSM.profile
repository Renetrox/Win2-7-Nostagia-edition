[blur]
as_pulse = false
s0_blur_speed = 3.500000
s0_focus_blur_match = toolbar | menu | utility | normal | dialog | modaldialog | class=GnoMenu.py | (name=gnome-panel)
s0_focus_blur = false
s0_alpha_blur_match = any
s0_alpha_blur = true
s0_filter = 1
s0_gaussian_radius = 5
s0_gaussian_strength = 0.200000
s0_mipmap_lod = 2.500000
s0_saturation = 100
s0_occlusion = true
s0_independent_tex = false

[reflex]
s0_file = ~/.Win2-7Reflect.png
s0_match = toolbar | normal | dialog | modaldialog
s0_window = true
s0_decoration = true
s0_threshold = 1
s0_moving = true

